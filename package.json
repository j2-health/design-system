{
  "name": "@j2-health/design-system",
  "version": "0.5.0",
  "type": "module",
  "description": "J2 Health shared React component library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j2-health/design-system.git"
  },
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.config.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.cjs"
    },
    "./style.css": "./dist/style.css",
    "./stylesheets/index.css": "./src/stylesheets/index.css",
    "./stylesheets/tailwind.css": "./src/stylesheets/tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/stylesheets"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepublishOnly": "npm run build",
    "lint": "eslint src",
    "prettier": "prettier --check src",
    "preview": "vite preview",
    "start": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "NODE_OPTIONS='--no-deprecation' vitest run",
    "test:tailwind": "node scripts/test-tailwind-consumers.mjs",
    "test:dev": "NODE_OPTIONS='--no-deprecation' vitest",
    "test:coverage": "NODE_OPTIONS='--no-deprecation' vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@highcharts/react": "^5.0.0",
    "@phosphor-icons/react": "^2.1.7",
    "antd": "^6.6.3",
    "classnames": "^2.5.1",
    "formik": "^2.4.6",
    "highcharts": "^13.0.1",
    "lodash": "^4.17.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "tailwindcss": "^3.4.14 || ^4.0.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@chromatic-com/storybook": "^5.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@highcharts/react": "^5.3.0",
    "@phosphor-icons/react": "^2.1.7",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-links": "^10.3.0",
    "@storybook/react-vite": "^10.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^5.0.1",
    "antd": "^6.6.3",
    "autoprefixer": "^10.4.20",
    "classnames": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.0",
    "formik": "^2.4.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "highcharts": "^13.0.1",
    "lodash": "^4.18.1",
    "postcss": "^8.5.28",
    "prettier": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.1",
    "yup": "^1.4.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.24.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
