{
  "name": "@j2-health/design-system",
  "version": "0.2.1",
  "type": "module",
  "description": "J2 Health shared React component library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j2-health/design-system.git"
  },
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.config.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.cjs"
    },
    "./style.css": "./dist/style.css",
    "./stylesheets/index.css": "./src/stylesheets/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/stylesheets"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepublishOnly": "npm run build",
    "lint": "eslint src",
    "prettier": "prettier --check src",
    "preview": "vite preview",
    "start": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "NODE_OPTIONS='--no-deprecation' vitest run",
    "test:dev": "NODE_OPTIONS='--no-deprecation' vitest",
    "test:coverage": "NODE_OPTIONS='--no-deprecation' vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@highcharts/react": "^4.2.1",
    "@phosphor-icons/react": "^2.1.7",
    "antd": "^5.21.2",
    "classnames": "^2.5.1",
    "formik": "^2.4.6",
    "formik-antd": "^3.0.0-beta.9",
    "highcharts": "^12.5.0",
    "lodash": "^4.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/js": "^9.11.1",
    "@highcharts/react": "^4.2.1",
    "@phosphor-icons/react": "^2.1.7",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-links": "^10.3.0",
    "@storybook/addon-onboarding": "^10.3.0",
    "@storybook/react-vite": "^10.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/lodash": "^4.17.14",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.0.18",
    "antd": "^5.21.2",
    "autoprefixer": "^10.4.20",
    "classnames": "^2.5.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^10.5.10",
    "formik": "^2.4.6",
    "formik-antd": "^3.0.0-beta.9",
    "globals": "^15.9.0",
    "happy-dom": "^20.9.0",
    "highcharts": "^12.5.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.26",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.3.5",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-svgr": "^4.2.0",
    "vitest": "^4.0.18",
    "yup": "^1.4.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.24.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
